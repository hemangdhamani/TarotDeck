<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)">
  <Profiles>
    <Profile Name="(Default)" />
  </Profiles>
  <Settings>
    <Setting Name="ReadingSpread" Type="System.String" Scope="User"><Value Profile="(Default)">Situation / Advice / Outcome</Value></Setting>
    <Setting Name="ReadingTopic" Type="System.String" Scope="User"><Value Profile="(Default)">General</Value></Setting>
    <Setting Name="ReadingFocus" Type="System.String" Scope="User"><Value Profile="(Default)">Overview</Value></Setting>
    <Setting Name="CardBackName" Type="System.String" Scope="User">
      <Value Profile="(Default)">Emerald Labyrinth</Value>
    </Setting>
    <Setting Name="AutoSpread" Type="System.Boolean" Scope="User">
      <Value Profile="(Default)">True</Value>
    </Setting>
    <Setting Name="CardSet" Type="System.Int32" Scope="User">
      <Value Profile="(Default)">0</Value>
    </Setting>
    <Setting Name="ArtworkName" Type="System.String" Scope="User">
      <Value Profile="(Default)">Classic Tarot</Value>
    </Setting>
  </Settings>
</SettingsFile>
